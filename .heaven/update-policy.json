{
  "schema": "heaven-toolbox/update-policy/v1",
  "repository": "fengie/Heaven.gg",
  "branch": "main",
  "kind": "product",
  "source_update": {
    "required": true,
    "strategy": "ff-only",
    "poll_interval_minutes": 1,
    "controller": "heaven-toolbox/repo-autoupdate"
  },
  "runtime_update": {
    "mode": "apply-script",
    "apply_script": "scripts/Apply-HeavenGg.ps1",
    "verify_script": "scripts/Test-HeavenGgRuntime.ps1",
    "target_host": "HEAVEN",
    "evidence_paths": [
      "web/private-host.mjs",
      "web/tests/h1-private-runtime.test.mjs",
      "web/DEPLOYMENT.md"
    ]
  }
}
